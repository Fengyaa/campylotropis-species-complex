#NEXUS
[Cleaned author commands. Run beside numbered.nex generated by prepare_svd_input.py.]
BEGIN PAUP;
 execute numbered.nex;
 outgroup 131 244;
 svdq taxpartition=SPECIES showScores=no seed=1234568 bootstrap=standard nreps=100 nthreads=8 treeFile=svd_bootstrap.tre;
 savetrees file=svd_consensus.tre from=1 to=1 format=newick savebootp=nodelabels;
END;
